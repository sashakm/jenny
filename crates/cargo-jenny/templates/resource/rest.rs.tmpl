//! The REST driving adapter for {{resource_plural}}.
//!
//! Everything HTTP-shaped lives here and nowhere else: the JSON DTOs, the conversions
//! into domain commands, and the status codes. Each handler is a few lines — extract,
//! convert, call — because anything longer would be business logic in the wrong ring.
//!
//! There is no PATCH handler, and the adapter still answers PATCH: it accepts JSON
//! Patch, so it derives one from `fetch` and `rename`. `fetch` sends the version as an
//! `ETag` and `rename` takes `If-Match`, so a patch fails with 412 instead of
//! overwriting a change made in between. The request DTO accepts the whole response
//! shape, ignoring what it does not take, so a patch applies to exactly what a client
//! read — and one that tries to change an ignored field is refused with 422.

use axum::extract::{Path, State};
use jenny::rest::{ApiResult, Ctx, IfMatch, Json, Listing, Routes, StatusCode, Versioned};
use jenny::{DomainError, Dto, Validate};
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use crate::application::{{resource_snake}}::{
    Create{{resource_pascal}}, Rename{{resource_pascal}}, {{resource_pascal}}s,
};
use crate::domain::model::{{resource_snake}}::{
    {{resource_pascal}}, {{resource_pascal}}Id, {{resource_pascal}}Name,
};

/// A {{resource_snake}} to create or replace.
///
/// Deliberately *not* shared with any other adapter — a gRPC adapter gets its own
/// protobuf type, and both convert into the same command.
///
/// `#[derive(Dto)]` turns these attributes into a `Validate` impl and, with the
/// `openapi` feature, the matching schema. One place to change a bound, and the
/// documentation cannot drift from what the code enforces.
#[derive(Debug, Deserialize, Dto)]
pub struct {{resource_pascal}}Request {
    #[dto(not_empty, max_len = 120, example = "first")]
    name: String,
}

{{#if openapi}}
/// This resource's part of the OpenAPI document. The runtime merges it with every other
/// adapter's and serves it at `<framework_path>/openapi.json`.
#[derive(utoipa::OpenApi)]
#[openapi(components(schemas({{resource_pascal}}Request)))]
pub struct {{resource_pascal}}Api;

{{/if}}
/// What this protocol returns.
#[derive(Debug, Serialize)]
pub struct {{resource_pascal}}Response {
    id: Uuid,
    name: String,
    archived: bool,
}

impl From<&{{resource_pascal}}> for {{resource_pascal}}Response {
    fn from(entity: &{{resource_pascal}}) -> Self {
        Self {
            id: entity.id().as_uuid(),
            name: entity.name().to_string(),
            archived: entity.is_archived(),
        }
    }
}

/// The `TryFrom` **is** the input validation.
///
/// The one place where untrusted strings become domain types. It fails with a
/// [`DomainError`], which the REST layer already knows how to turn into a 400, so no
/// handler validates anything itself.
impl TryFrom<{{resource_pascal}}Request> for Create{{resource_pascal}} {
    type Error = DomainError;

    fn try_from(dto: {{resource_pascal}}Request) -> Result<Self, Self::Error> {
        // Format rules first, from the derive; then the domain's own constructor, which
        // is what actually makes an invalid name unrepresentable.
        dto.validate()?;
        Ok(Create{{resource_pascal}} {
            name: {{resource_pascal}}Name::new(dto.name)?,
        })
    }
}

impl TryFrom<{{resource_pascal}}Request> for Rename{{resource_pascal}} {
    type Error = DomainError;

    fn try_from(dto: {{resource_pascal}}Request) -> Result<Self, Self::Error> {
        let Create{{resource_pascal}} { name } = dto.try_into()?;
        Ok(Rename{{resource_pascal}} { name })
    }
}

async fn list(
    State(service): State<{{resource_pascal}}s>,
    listing: Listing,
    cx: Ctx,
) -> ApiResult<Json<Vec<{{resource_pascal}}Response>>> {
    let found = service.list(&listing, &cx).await?;
    Ok(Json(found.iter().map({{resource_pascal}}Response::from).collect()))
}

async fn create(
    State(service): State<{{resource_pascal}}s>,
    cx: Ctx,
    Json(dto): Json<{{resource_pascal}}Request>,
) -> ApiResult<(StatusCode, Json<Uuid>)> {
    let id = service.create(dto.try_into()?, &cx).await?;
    Ok((StatusCode::CREATED, Json(id.as_uuid())))
}

async fn fetch(
    State(service): State<{{resource_pascal}}s>,
    Path(id): Path<Uuid>,
    cx: Ctx,
) -> ApiResult<Versioned<Json<{{resource_pascal}}Response>>> {
    let entity = service.fetch({{resource_pascal}}Id::from_uuid(id), &cx).await?;
    Ok(Versioned::new(
        entity.version(),
        Json({{resource_pascal}}Response::from(&*entity)),
    ))
}

async fn rename(
    State(service): State<{{resource_pascal}}s>,
    Path(id): Path<Uuid>,
    IfMatch(expected): IfMatch,
    cx: Ctx,
    Json(dto): Json<{{resource_pascal}}Request>,
) -> ApiResult<StatusCode> {
    service
        .rename({{resource_pascal}}Id::from_uuid(id), dto.try_into()?, expected, &cx)
        .await?;
    Ok(StatusCode::NO_CONTENT)
}

async fn archive(
    State(service): State<{{resource_pascal}}s>,
    Path(id): Path<Uuid>,
    cx: Ctx,
) -> ApiResult<StatusCode> {
    service.archive({{resource_pascal}}Id::from_uuid(id), &cx).await?;
    Ok(StatusCode::NO_CONTENT)
}

async fn delete(
    State(service): State<{{resource_pascal}}s>,
    Path(id): Path<Uuid>,
    IfMatch(expected): IfMatch,
    cx: Ctx,
) -> ApiResult<Json<{{resource_pascal}}Response>> {
    let removed = service
        .delete({{resource_pascal}}Id::from_uuid(id), expected, &cx)
        .await?;
    Ok(Json({{resource_pascal}}Response::from(&removed)))
}

/// The whole adapter, as one value. No trait to implement, nothing to erase.
pub fn routes(service: {{resource_pascal}}s) -> Routes {
    Routes::new("{{resource_plural}}")
        .describe("Create, read, rename, archive and delete {{resource_plural}}")
        .label("kind", "crud")
        .get("/{{resource_plural}}", list)
        .post("/{{resource_plural}}", create)
        .get("/{{resource_plural}}/{id}", fetch)
        .put("/{{resource_plural}}/{id}", rename)
        .delete("/{{resource_plural}}/{id}", delete)
        .post("/{{resource_plural}}/{id}/archive", archive)
        .with_state(service)
}
