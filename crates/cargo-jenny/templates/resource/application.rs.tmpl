//! The {{resource_pascal}} use cases.

use std::sync::Arc;

use jenny::{Context, Criteria, DomainResult, Events, Loaded, StoreExt, Version, use_cases};

use crate::domain::model::{{resource_snake}}::{
    {{resource_pascal}}, {{resource_pascal}}Id, {{resource_pascal}}Name,
};
use crate::domain::port::{{resource_snake}}_store::{{resource_pascal}}Store;

/// The types every inbound adapter converges on.
///
/// A REST DTO, a protobuf message and a CLI argument struct all differ — they should.
/// What makes them interchangeable *drivers* of the same behaviour is that each converts
/// into one of these. The fields are already domain types: turning a `String` into a
/// [`{{resource_pascal}}Name`] is the adapter's job, on the way in. Which
/// {{resource_snake}} a command is about is the use case's other argument.
pub struct Create{{resource_pascal}} {
    pub name: {{resource_pascal}}Name,
}

pub struct Rename{{resource_pascal}} {
    pub name: {{resource_pascal}}Name,
}

/// Everything you can do with a {{resource_pascal}}.
///
/// A plain struct holding its outbound ports, cheap to clone. Swapping the in-memory
/// store for a database is a change in `lib.rs` and nowhere else.
#[derive(Clone)]
pub struct {{resource_pascal}}s {
    store: Arc<{{resource_pascal}}Store>,
    events: Events,
}

/// `#[use_cases]` gives every `pub async fn` below a `use_case` span —
/// `{{resource_snake}}s.create` and so on — and a `jenny.usecase.duration` measurement
/// labelled with its outcome. It wraps the bodies and generates nothing else.
#[use_cases]
impl {{resource_pascal}}s {
    pub fn new(store: Arc<{{resource_pascal}}Store>, events: Events) -> Self {
        Self { store, events }
    }

    pub async fn create(
        &self,
        cmd: Create{{resource_pascal}},
        cx: &Context,
    ) -> DomainResult<{{resource_pascal}}Id> {
        let (entity, created) = {{resource_pascal}}::create(cmd.name);
        let entity = self.store.insert(entity).await?;
        // Publish only once the state change has been committed.
        self.events.publish(&created, cx).await;
        Ok(entity.id())
    }

    /// Paging, sorting and filtering are the store's job; which attributes a client may
    /// name is the allowlist it was built with in `lib.rs`.
    pub async fn list(
        &self,
        criteria: &Criteria,
        _cx: &Context,
    ) -> DomainResult<Vec<{{resource_pascal}}>> {
        self.store.list(criteria).await
    }

    pub async fn fetch(
        &self,
        id: {{resource_pascal}}Id,
        _cx: &Context,
    ) -> DomainResult<Loaded<{{resource_pascal}}>> {
        self.store.load(&id).await
    }

    /// Rename — if it is still at `expected`, when the caller says which version it read
    /// (an HTTP `If-Match`).
    ///
    /// Listeners hear a `{{resource_snake}}.updated` carrying exactly what changed, as a
    /// JSON Patch. A rename to the same name writes and publishes nothing.
    pub async fn rename(
        &self,
        id: {{resource_pascal}}Id,
        cmd: Rename{{resource_pascal}},
        expected: Option<Version>,
        cx: &Context,
    ) -> DomainResult<()> {
        // The rule about renaming archived entities lives in the aggregate, not here.
        let renamed = self
            .store
            .change_at(&id, expected, |entity| entity.rename(cmd.name))
            .await?;
        if let Some(updated) = renamed.updated() {
            self.events.publish(&updated, cx).await;
        }
        Ok(())
    }

    pub async fn archive(&self, id: {{resource_pascal}}Id, _cx: &Context) -> DomainResult<()> {
        self.store
            .change(&id, {{resource_pascal}}::archive)
            .await?;
        Ok(())
    }

    pub async fn delete(
        &self,
        id: {{resource_pascal}}Id,
        expected: Option<Version>,
        _cx: &Context,
    ) -> DomainResult<{{resource_pascal}}> {
        self.store.remove(&id, expected).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use jenny::DomainError;
    use jenny::domain::ValueKind;
    use jenny::memory::Memory;
    use jenny::testing::RecordedEvents;

    fn subject() -> ({{resource_pascal}}s, Arc<RecordedEvents>) {
        let events = Arc::new(RecordedEvents::default());
        let service = {{resource_pascal}}s::new(
            Arc::new(Memory::<{{resource_pascal}}>::new().queryable([("name", ValueKind::Text)])),
            Events::new(events.clone()),
        );
        (service, events)
    }

    fn name(raw: &str) -> {{resource_pascal}}Name {
        {{resource_pascal}}Name::new(raw).unwrap()
    }

    #[tokio::test]
    async fn creating_stores_and_publishes() {
        let (service, events) = subject();
        let cx = Context::new();

        let id = service
            .create(Create{{resource_pascal}} { name: name("first") }, &cx)
            .await
            .unwrap();

        assert_eq!(service.fetch(id, &cx).await.unwrap().name().as_str(), "first");
        assert_eq!(events.names(), ["{{resource_snake}}.created"]);
    }

    #[tokio::test]
    async fn fetching_something_absent_is_not_found() {
        let (service, _) = subject();
        let err = service
            .fetch({{resource_pascal}}Id::generate(), &Context::new())
            .await
            .unwrap_err();
        assert!(matches!(err, DomainError::NotFound));
    }

    #[tokio::test]
    async fn renaming_says_what_changed() {
        let (service, events) = subject();
        let cx = Context::new();
        let id = service
            .create(Create{{resource_pascal}} { name: name("first") }, &cx)
            .await
            .unwrap();

        service
            .rename(id, Rename{{resource_pascal}} { name: name("second") }, None, &cx)
            .await
            .unwrap();

        assert_eq!(service.fetch(id, &cx).await.unwrap().version().get(), 2);
        let updated = events.payloads("{{resource_snake}}.updated");
        assert_eq!(updated.len(), 1);
        assert_eq!(updated[0]["changes"][0]["path"], "/name");
    }

    #[tokio::test]
    async fn a_rename_against_a_version_that_moved_on_is_stale() {
        let (service, _) = subject();
        let cx = Context::new();
        let id = service
            .create(Create{{resource_pascal}} { name: name("first") }, &cx)
            .await
            .unwrap();
        let read = service.fetch(id, &cx).await.unwrap().version();
        service
            .rename(id, Rename{{resource_pascal}} { name: name("second") }, Some(read), &cx)
            .await
            .unwrap();

        let err = service
            .rename(id, Rename{{resource_pascal}} { name: name("third") }, Some(read), &cx)
            .await
            .unwrap_err();
        assert!(matches!(err, DomainError::Stale { .. }), "{err}");
    }

    #[tokio::test]
    async fn archiving_twice_conflicts() {
        let (service, _) = subject();
        let cx = Context::new();
        let id = service
            .create(Create{{resource_pascal}} { name: name("first") }, &cx)
            .await
            .unwrap();

        service.archive(id, &cx).await.unwrap();
        assert!(matches!(
            service.archive(id, &cx).await.unwrap_err(),
            DomainError::Conflict { .. }
        ));
    }

    #[tokio::test]
    async fn deleting_returns_what_was_removed() {
        let (service, _) = subject();
        let cx = Context::new();
        let id = service
            .create(Create{{resource_pascal}} { name: name("first") }, &cx)
            .await
            .unwrap();

        assert_eq!(service.delete(id, None, &cx).await.unwrap().id(), id);
        assert!(matches!(
            service.delete(id, None, &cx).await.unwrap_err(),
            DomainError::NotFound
        ));
    }
}
