//! The outbound port for {{resource_pascal}} storage — declared by the domain.
//!
//! This is the half of hexagonal architecture that inverts the dependency. The domain
//! says what it needs in its own vocabulary, and a driven adapter supplies it.
//!
//! {{resource_pascal}}s are found by id or listed, so jenny's `Store` is the whole port:
//! load, save with a version check, remove, list. When the domain needs a query of its
//! own, declare it here on a trait extending it, and hold an `Arc<dyn …>` of that
//! instead:
//!
//! ```ignore
//! #[async_trait]
//! pub trait {{resource_pascal}}Repository: Store<{{resource_pascal}}> {
//!     async fn archived_before(&self, cutoff: DateTime<Utc>) -> DomainResult<Vec<{{resource_pascal}}>>;
//! }
//! ```

use jenny::Store;

use crate::domain::model::{{resource_snake}}::{{resource_pascal}};

/// Where {{resource_plural}} live.
pub type {{resource_pascal}}Store = dyn Store<{{resource_pascal}}>;
