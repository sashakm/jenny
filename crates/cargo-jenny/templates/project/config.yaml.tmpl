# Configuration for {{project_kebab}}.
#
# The runtime reads `service_name`, `service_version`, `system`, `tasks`, `server`, `telemetry`,
# `messaging`, `persistence` and `objects`.
# Everything under `applications.<name>` is yours, passed through untouched.
#
# Any value can be overridden by an environment variable
# (JENNY__SERVER__ADDRESS=[::]:9000) or a CLI flag (--address).

# Who the service is: names event topics, NATS buckets and consumers, and the system
# principal its scheduled tasks and event handlers run as. Defaults to the package name;
# `service_version` (default: the package version) works the same way.
service_name: {{project_kebab}}

# With several replicas, run each slot of a scheduled task on one of them only: the one
# that acquires its lease. Unset, every replica runs every task. `postgres` needs the
# persistence feature and `persistence.postgres`, `nats` the messaging feature and
# `messaging.nats`; `memory` is for one replica. The ttl, in seconds, must exceed the
# clock skew between replicas.
# tasks:
#   lease:
#     backend: postgres
#     ttl: 30

server:
  address: "[::]:8000"
  # Where REST adapters mount unless one chose a path in code.
  api_path: /api
  # The default prefix of health, metrics and OpenAPI, namespaced away from your API
  # (a group's own `path` under `endpoints` replaces it).
  framework_path: /j
  # After SIGTERM, keep serving (reported not ready) this long before closing, so a
  # load balancer can stop routing here first. About 5 on Kubernetes.
  # shutdown_delay_seconds: 5
  # Then wait at most this long for in-flight requests and scheduled runs.
  # shutdown_timeout_seconds: 30
  # A second port for health, metrics and OpenAPI, at the same paths. The API port
  # then answers /j/... with 404, so no ingress can publish them by accident. Off
  # here, so `cargo run` keeps one port.
  # management:
  #   address: "[::]:8081"
  # Each group of the framework's endpoints (probes, status, metrics, openapi,
  # swagger, public_status): enabled, listener (api | management), path, log_requests.
  # Probes, status and metrics are not access-logged unless log_requests is true.
  # endpoints:
  #   swagger: { enabled: true }  # with the swagger-ui feature; off by default, goes where openapi is
  #   # {"status": "up" | "degraded" | "down"}, nothing else: fit for the public.
  #   public_status: { enabled: true, listener: api, path: /status }
  #   metrics:
  #     auth:
  #       username: prometheus
  #       password: change-me

telemetry:
  # service_name and service_version default to the ones above; set them here to
  # rename the service in telemetry only.
  log_format: pretty
  # otlp_endpoint: "http://localhost:4317"
{{#if messaging}}

messaging:
  buffer_size: 64
  # Headers every event `server.events()` raises carries. Off by default: a caller's id
  # is personal data, and a stream keeps it for as long as its retention says.
  # events:
  #   headers:
  #     caller: true                  # caller-subject, and caller-actor when delegated
  #     source: true                  # source-service, source-version
  # How event handlers (`server.handle(…)`, `MessagingAdapter::on(…)`) run, and what
  # becomes of a JetStream message whose handler fails.
  # inbound:
  #   principal: system               # or envelope: run as the event's caller
  #   max_deliver: 5
  #   backoff: [1, 5, 30]             # seconds before each redelivery; the last repeats
  #   dead_letter: {{project_snake}}.dead
  #   max_in_flight: 1                # per consumer; 1 keeps order
  #   subscriptions:                  # overrides, matched on the full subject
  #     - subject: orders.created
  #       max_deliver: 10
  # The service's NATS connection: key-value stores (`server.nats()`) and the gateway
  # (`nats.gateway(…)`) share it. With `url` set the runtime connects at startup;
  # compose.yaml starts a NATS.
  # nats:
  #   url: nats://localhost:4222
  #   # A production NATS usually wants TLS and credentials. Paths are read again at
  #   # each connect, and a rotated certificate or .creds file reconnects the service.
  #   refresh_interval: 30            # seconds between looks at the files below
  #   tls:                            # present, even empty: TLS on every server
  #     ca: /etc/nats-tls/ca.crt      # default: the system's roots
  #     cert: /etc/nats-tls/tls.crt   # client certificate, for mTLS
  #     key: /etc/nats-tls/tls.key
  #   auth:                           # at most one of:
  #     creds: /etc/nats/service.creds  # user JWT + NKey seed
  #     # nkey: …                     # JENNY__MESSAGING__NATS__AUTH__NKEY
  #     # user: {{project_snake}}     # with JENNY__MESSAGING__NATS__AUTH__PASSWORD
  #     # token: …                    # JENNY__MESSAGING__NATS__AUTH__TOKEN
{{/if}}
{{#if persistence}}

persistence:
  postgres:
    # Unset, the service keeps its data in memory. It carries the password, so set it
    # through the environment (JENNY__PERSISTENCE__POSTGRES__URL) rather than here;
    # `just up` starts the Postgres from compose.yaml and `just run-postgres` uses it.
    # url: postgres://{{project_snake}}:{{project_snake}}@localhost:5432/{{project_snake}}
    max_connections: 10
{{#if graph}}
    # Creates the tables before serving, and, for each `postgres.graph(…)`, the Apache
    # AGE extension and that graph.
    create_tables: true
{{/if}}
{{#if messaging}}
    # Commit the events a change raises in the same transaction as the change, and
    # forward them to the event bus from there, so a crash cannot lose one.
    outbox: true
{{/if}}
{{/if}}

applications:
  {{project_kebab}}:
    greeting: "hello from config.yaml"
{{#if objects}}

# Object storage. Unset, there is none and `server.objects()` is `None`. `just up`
# starts one and `just run-objects` points the service at it. On AWS the URL is enough:
# the standard AWS_* variables and the service's role supply the rest. Options carry
# secrets, so set them through the environment (JENNY__OBJECTS__OPTIONS__...). The whole
# section is commented out because an `objects:` with nothing under it is not a section.
# objects:
#   url: s3://{{project_kebab}}
#   options:
#     endpoint: http://localhost:9000
#     allow_http: "true"
#     # conditional_put: etag   # conditional writes, for a server that honours If-Match
{{/if}}
