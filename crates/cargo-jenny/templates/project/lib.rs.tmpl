//! {{project_kebab}} — a jenny service.
//!
//! The service is a library so that `main.rs` and the integration tests share one
//! crate root: a test can call [`build`] and exercise the real composition root rather
//! than a rebuilt approximation of it.
//!
//! Read `build` below top to bottom and you have the whole dependency graph: driven
//! adapters first, then the use cases that depend on them, then the driving adapter
//! that depends on those. Every arrow points inward. There is no container — if it is
//! not wired here, it does not exist.

pub mod adapter;
pub mod application;
pub mod domain;

use std::sync::Arc;

use anyhow::Result;
{{#if messaging}}
{{else}}
use jenny::Events;
{{/if}}
use jenny::domain::ValueKind;
use jenny::memory::Memory;
{{#if objects}}
use jenny::memory::MemoryBlobs;
use jenny::port::Blobs;
{{/if}}
use jenny::rest::RestAdapter;
use jenny::server::JennyServer;
use serde::Deserialize;

{{#if messaging}}
use adapter::outbound::events::EventLogListener;
{{else}}
use adapter::outbound::events::EventLog;
{{/if}}
use application::{{resource_snake}}::{{resource_pascal}}s;
use domain::model::{{resource_snake}}::{{resource_pascal}};
{{#if persistence}}
use domain::port::{{resource_snake}}_store::{{resource_pascal}}Store;
{{/if}}

/// What a {{resource_snake}} listing may sort and filter on, and what each attribute holds.
///
/// The security boundary for client-supplied criteria: a listing that names anything
/// else is refused before it reaches the data, so `filter=…` cannot become a question
/// about a field the API never shows. Every store takes the same list.
const {{resource_screaming}}_QUERYABLE: [(&str, ValueKind); 2] =
    [("name", ValueKind::Text), ("archived", ValueKind::Bool)];

/// This service's own configuration, from `applications.{{project_kebab}}`. The
/// framework imposes no schema on it — the shape below is entirely ours.
#[derive(Debug, Deserialize)]
struct Config {
    greeting: String,
}

impl Default for Config {
    fn default() -> Self {
        Self {
            greeting: "hello from the built-in default".to_string(),
        }
    }
}

/// Wire the service together. Shared by `main` and the integration test, so the test
/// exercises the real composition root.
{{#if mutable_server}}
pub fn build(mut server: JennyServer) -> Result<JennyServer> {
{{else}}
pub fn build(server: JennyServer) -> Result<JennyServer> {
{{/if}}
    let config: Config = server
        .context()
        .app_section("{{project_kebab}}")
        .unwrap_or_default();
    tracing::info!("{{project_kebab}} says: {}", config.greeting);

    // --- driven adapters: the outside world, as the domain's ports see it ----------
{{#if persistence}}
    //
    // With `persistence.postgres.url` configured, {{resource_plural}} live in Postgres:
    // one jsonb row each, the table created before the server starts. Without it they
    // live in memory, which is what the tests use. The use cases cannot tell.
{{#if graph}}
    //
    // A question no store answers — what is connected to what — goes on a port of
    // your own, and its adapter queries a graph in the same database:
    // `postgres.graph("{{project_snake}}")`, in Cypher (see `jenny::persistence::graph`).
    // The runtime creates the graph before serving.
{{/if}}
    let {{resource_plural}}_store: Arc<{{resource_pascal}}Store> = match server.postgres()? {
        Some(postgres) => Arc::new(
            postgres
                .documents::<{{resource_pascal}}>()
                .queryable({{resource_screaming}}_QUERYABLE),
        ),
        None => Arc::new(Memory::<{{resource_pascal}}>::new().queryable({{resource_screaming}}_QUERYABLE)),
    };
{{else}}
    let {{resource_plural}}_store =
        Arc::new(Memory::<{{resource_pascal}}>::new().queryable({{resource_screaming}}_QUERYABLE));
{{/if}}
{{#if objects}}

    // Files go through the `Blobs` port: the object store `objects.url` names (an S3
    // bucket, a directory), or memory without one. Once asked for, the store is in
    // `/j/health/ready`. Hand it to the use cases that keep files.
    let _blobs: Arc<dyn Blobs> = match server.objects()? {
        Some(objects) => objects,
        None => Arc::new(MemoryBlobs::new()),
    };
{{/if}}
{{#if messaging}}

    // The runtime started an in-process bus; one publish fans out to every listener.
    // `events()` carries the headers `messaging.events.headers` turns on.
    server.subscribe(EventLogListener)?;
    let events = server.events()?;
{{else}}
    let events = Events::new(Arc::new(EventLog));
{{/if}}

    // --- application: use cases over those ports -----------------------------------
    let {{resource_plural}} = {{resource_pascal}}s::new({{resource_plural}}_store, events);

    // --- driving adapter: HTTP in --------------------------------------------------
    // No path given, so it takes `server.api_path` from configuration. It accepts JSON
    // Patch, so every route with a GET and a PUT also answers PATCH, derived from those
    // two; drop that line and PATCH is 405.
    let rest = RestAdapter::new("{{project_kebab}}")?
        .describe("{{project_kebab}}")
        .accept_json_patch()?
        .mount(adapter::inbound::rest::{{resource_snake}}::routes({{resource_plural}}))?;
{{#if openapi}}
    // The schemas `#[derive(Dto)]` produced, served at `<framework_path>/openapi.json`.
    let rest = rest.with_openapi(
        <adapter::inbound::rest::{{resource_snake}}::{{resource_pascal}}Api as utoipa::OpenApi>::openapi(),
    );
{{/if}}

    server.register(rest)
}
