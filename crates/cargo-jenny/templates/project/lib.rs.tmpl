//! {{project_kebab}} — a jenny service.
//!
//! The service is a library so that `main.rs` and the integration tests share one
//! crate root: a test can call [`build`] and exercise the real composition root rather
//! than a rebuilt approximation of it.
//!
//! Read `build` below top to bottom and you have the whole dependency graph: driven
//! adapters first, then the use cases that depend on them, then the driving adapter
//! that depends on those. Every arrow points inward. There is no container — if it is
//! not wired here, it does not exist.

pub mod adapter;
pub mod application;
pub mod domain;

use std::sync::Arc;

use anyhow::Result;
use async_trait::async_trait;
use jenny::rest::RestAdapter;
use jenny::server::{HealthCheck, JennyServer};
use serde::Deserialize;

use adapter::outbound::{{resource_snake}}_repository::InMemory{{resource_pascal}}s;
{{#if messaging}}
use adapter::outbound::events::EventLogListener;
{{else}}
use adapter::outbound::events::EventLog;
use jenny::EventPublisher;
{{/if}}
use application::{{resource_snake}}::{{resource_pascal}}s;

/// This service's own configuration, from `applications.{{project_kebab}}`. The
/// framework imposes no schema on it — the shape below is entirely ours.
#[derive(Debug, Deserialize)]
struct Config {
    greeting: String,
}

impl Default for Config {
    fn default() -> Self {
        Self {
            greeting: "hello from the built-in default".to_string(),
        }
    }
}

/// A readiness signal backed by the store.
///
/// `/health/ready` reports it, so a load balancer stops sending traffic when the store
/// is unusable — while `/health/live` stays up, because restarting the process would
/// not fix a broken dependency.
struct StoreIsUsable(Arc<InMemory{{resource_pascal}}s>);

#[async_trait]
impl HealthCheck for StoreIsUsable {
    fn name(&self) -> &str {
        "{{resource_snake}}-store"
    }

    fn kind(&self) -> &str {
        "store"
    }

    async fn check(&self) -> std::result::Result<(), String> {
        if self.0.is_healthy() {
            Ok(())
        } else {
            Err("store is unavailable".to_string())
        }
    }
}

/// Wire the service together. Shared by `main` and the integration test, so the test
/// exercises the real composition root.
{{#if messaging}}
pub fn build(mut server: JennyServer) -> Result<JennyServer> {
{{else}}
pub fn build(server: JennyServer) -> Result<JennyServer> {
{{/if}}
    let config: Config = server
        .context()
        .app_section("{{project_kebab}}")
        .unwrap_or_default();
    tracing::info!("{{project_kebab}} says: {}", config.greeting);

    // --- driven adapters: the outside world, as the domain's ports see it ----------
    let repository = Arc::new(InMemory{{resource_pascal}}s::default());
{{#if messaging}}

    // The runtime started an in-process bus; one publish fans out to every listener.
    server.subscribe(EventLogListener)?;
    let events = server.events()?;
{{else}}

    // Erased on purpose: the repository below is a generic parameter (static dispatch),
    // while the publisher is chosen here and passed as a trait object. Both are ports;
    // which dispatch you use is a wiring decision, not a design one.
    let events: Arc<dyn EventPublisher> = Arc::new(EventLog);
{{/if}}

    // --- application: use cases over those ports -----------------------------------
    let {{resource_plural}} = Arc::new({{resource_pascal}}s::new(repository.clone(), events));

    // --- driving adapter: HTTP in --------------------------------------------------
    // No path given, so it takes `server.api_path` from configuration.
    let rest = RestAdapter::new("{{project_kebab}}")?
        .describe("{{project_kebab}}")
        .mount(adapter::inbound::rest::{{resource_snake}}::routes({{resource_plural}}))?;

    Ok(server
        .with_version(jenny::service_version!())
        .register(rest)?
        .register_health_check(StoreIsUsable(repository)))
}
