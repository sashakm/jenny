default: check test

# Compile everything, including tests.
check:
    cargo clippy --all-targets -- -D warnings
    cargo fmt --all --check

test:
    cargo test

run:
    cargo run -- --config-path config.yaml
{{#if persistence}}

# Run against the Postgres from `just up`; `/j/health/ready` then reports it.
run-postgres:
    JENNY__PERSISTENCE__POSTGRES__URL=postgres://{{project_snake}}:{{project_snake}}@localhost:5432/{{project_snake}} cargo run -- --config-path config.yaml
{{/if}}
{{#if objects}}

# Run with the object store from `just up` configured: `server.objects()` hands it to
# whatever wires it in, and `/j/health/ready` reports it from then on.
run-objects:
    JENNY__OBJECTS__URL=s3://{{project_kebab}} AWS_ENDPOINT=http://localhost:9000 AWS_ALLOW_HTTP=true AWS_REGION=us-east-1 AWS_ACCESS_KEY_ID={{project_snake}} AWS_SECRET_ACCESS_KEY={{project_snake}}-secret cargo run -- --config-path config.yaml
{{/if}}

# Development dependencies (Postgres, collector, ...).
up:
    docker compose up -d

down:
    docker compose down -v

# Rebuild the release image.
image:
    docker build -t {{project_kebab}}:dev .

fmt:
    cargo fmt --all
