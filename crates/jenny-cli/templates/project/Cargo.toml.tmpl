[package]
name = "{{project_kebab}}"
version = "0.1.0"
edition = "2024"

# Standalone: not part of any surrounding cargo workspace.
[workspace]

[dependencies]
jenny = { {{jenny_dependency}}, features = [{{jenny_features}}] }
anyhow = "1"
async-trait = "0.1"
axum = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
tracing = "0.1"
uuid = { version = "1", features = ["serde", "v4"] }
{{#if persistence}}
sqlx = { version = "0.9", features = ["runtime-tokio", "tls-rustls", "postgres", "uuid", "chrono"] }
{{/if}}

[dev-dependencies]
reqwest = { version = "0.13", features = ["json"] }
